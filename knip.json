{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "scripts/*.ts",
    "scripts/overnight/*.ts",
    "workers/*/src/index.ts",
    "test/**/*.test.ts"
  ],
  "project": [
    "scripts/**/*.ts",
    "workers/**/*.ts"
  ],
  "ignoreExportsUsedInFile": true,
  // #6340: definição da flag de rollout do double opt-in (workers/poll) —
  // issue-fatia intencionalmente pequena, "REFS #6340, NÃO CLOSES", que só
  // declara a flag antes do rollout real (bloqueado por #6339/#6318). Arquivo
  // ainda não é importado de propósito. Remover desta lista quando
  // workers/poll/src/index.ts (ou subscribeToKit) passar a importar
  // DOUBLE_OPT_IN_FLAG.
  "ignore": ["workers/poll/src/optin-flag-6340.ts"],
  // #3164: ci.yml passou a rodar `npx tsc -p tsconfig.json --noEmit` dentro de
  // workers/brevo-dashboard/ — o plugin de GitHub Actions do knip lê esse `run:`,
  // resolve workers/brevo-dashboard/tsconfig.json e checa a dependência declarada
  // em `compilerOptions.types` (@cloudflare/workers-types) contra o package.json
  // RAIZ (knip.json não declara "workspaces" pra reconhecer o package.json próprio
  // do worker). Falso-positivo: a dep está corretamente listada em
  // workers/brevo-dashboard/package.json (devDependencies), só não no root.
  "ignoreDependencies": ["@cloudflare/workers-types"],
  // test/systemd-units.test.ts (#4807) faz shell-out condicional pro parser
  // real do systemd (`systemd-analyze calendar`) pra validar o OnCalendar=
  // gerado -- binário do sistema (Linux), nunca uma dependência npm; o teste
  // já faz skip gracioso se ausente (CI/macOS/Windows).
  // scripts/sync-env.ts (#5149) invoca o CLI `doppler` via execFileSync --
  // binário externo (secrets manager), não uma dependência npm.
  // scripts/google-ads-associate-token.ts (#5294) invoca `rundll32` (Windows,
  // System32) pra abrir a URL de consentimento OAuth sem passar por cmd.exe --
  // utilitário do SO, não uma dependência npm.
  "ignoreBinaries": ["systemd-analyze", "doppler", "rundll32"]
}

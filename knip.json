{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // #7117: `workers/` virou npm workspace (`workspaces: ["workers/*"]` no
  // package.json raiz) — o knip DETECTA isso sozinho a partir do
  // package.json e passa a tratar cada worker como workspace próprio (13
  // workspaces: raiz + 12), atribuindo cada arquivo ao workspace mais
  // específico que o contém. Uma vez que a chave "workspaces" abaixo existe,
  // knip IGNORA entry/project no nível raiz do arquivo — cada workspace
  // (inclusive ".") precisa declarar os seus. "." replica exatamente o que
  // era top-level antes (`scripts/`+`test/`); "workers/*" ganha bloco
  // próprio (senão cai no default do knip — só `src/index.ts` como entry —
  // e QUALQUER arquivo de teste dentro de um worker vira falso-positivo
  // "Unused files", achado ao vivo com `workers/linkedin-cron/test/*.test.ts`,
  // o único worker com pasta de teste própria).
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "scripts/overnight/*.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "scripts/**/*.ts"
      ]
    },
    "workers/*": {
      "entry": ["src/index.ts", "test/**/*.test.ts"],
      "project": ["**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  // test/systemd-units.test.ts (#4807) faz shell-out condicional pro parser
  // real do systemd (`systemd-analyze calendar`) pra validar o OnCalendar=
  // gerado -- binário do sistema (Linux), nunca uma dependência npm; o teste
  // já faz skip gracioso se ausente (CI/macOS/Windows).
  // scripts/sync-env.ts (#5149) invoca o CLI `doppler` via execFileSync --
  // binário externo (secrets manager), não uma dependência npm.
  // scripts/google-ads-associate-token.ts (#5294) invoca `rundll32` (Windows,
  // System32) pra abrir a URL de consentimento OAuth sem passar por cmd.exe --
  // utilitário do SO, não uma dependência npm.
  "ignoreBinaries": ["systemd-analyze", "doppler", "rundll32"]
}

node_modules
dist/
.env
.env.local
# Backup de 1 nível escrito por scripts/sync-env.ts (#5155) antes de
# sobrescrever .env com o snapshot do Doppler.
.env.bak
# data/ inteira mora no OneDrive (junction local) — nada vai pro repo.
# Antes do PR #1355 havia exceções intencionais aqui pra versionar audit
# trail editorial (data/editions/*/01-categorized.{md,json}, 01-approved.json
# e data/monthly/*/{prioritized.md,raw-destaques.json}). Foram removidas
# conscientemente — OneDrive sync + Drive sync cobrem reprodutibilidade
# entre máquinas. Não reverter pra exceções sem revisar essa decisão.
# Logs append-only por fonte (data/sources/*.jsonl) também moram aqui:
# crescem indefinidamente, valor analítico só local.
data
# Scheduling lockfile (ephemeral por execução)
.claude/scheduled_tasks.lock
# #3423: lock de arquivo do sync-code (git-sync.ts) — serializa syncCode()
# concorrentes contra o mesmo checkout; sempre removido em `finally`, mas
# ignorar por segurança caso sobreviva a um crash (staleness cleanup no próximo run).
.diaria-sync.lock/
.DS_Store
.tmp/
# Cloudflare Wrangler local build/cache state (root + workers/*/.wrangler)
.wrangler/
# Tipos gerados por `wrangler types` — regenerável, não versionar
worker-configuration.d.ts
# #2020: artefatos de lint/review por edição — destino canônico é data/editions/{AAMMDD}/_internal/;
# padrões aqui são rede de segurança caso um agente escreva na raiz por engano
lint-result-*.json
review-result-*.json
.claude/worktrees/
# #2825: settings.local.json é machine-local por convenção do Claude Code
# (allowlist de permissões pessoais/locais) e nunca deve ser versionado —
# vazou acidentalmente via `git add -A` num subagente overnight (#2824).
.claude/settings.local.json

# Projeto local que mora dentro do repo por conveniência — não é da diar.ia.br.
# Sem esta linha, qualquer `git add -A` (de sessão paralela ou subagente) o
# arrasta pra dentro do repo, como já aconteceu com settings.local.json (#2824).
nimbalyst-local/

# #4805: output default de `scripts/setup-systemd-timers.ts` — units systemd
# gerados localmente (equivalente Linux dos setup-*-schedule.ps1 do Windows,
# que também não são commitados enquanto ARMADOS na máquina). Regenerável a
# qualquer momento a partir de scripts/lib/scheduled-tasks.ts.
.systemd-units/

# #6347: diretórios temporários criados EM RUNTIME por vários testes
# (test/backup-beehiiv.test.ts, test/normalize-newsletter.test.ts,
# test/lint-newsletter-md.test.ts) via mkdirSync/writeFileSync, sempre
# limpos no fim do caso via rmSync — nunca destinados a ir pro git. Sem esta
# entrada, um crash de suíte no meio de um caso deixa resíduo no working
# tree que um `git add -A` de sessão paralela pode commitar por engano
# (foi o que aconteceu com test/_tmp_intentional_error/orphan_box_ok/
# 02-reviewed.md, removido do rastreamento nesta mesma mudança — vazava
# como deleção em qualquer PR alheia que rodasse a suíte localmente).
test/_tmp_*/
# #6541: runtime temp dirs created by overnight/test scripts — never source.
# ATENÇÃO: comentário em linha PRÓPRIA. .gitignore não suporta comentário
# inline — de 2026-08 a 2026-08-29 esta regra viveu como
# `scripts/_tmp_*/  # ...` e casava com NADA, deixando passar um artefato
# de runtime com e-mail de 100 assinantes pro repo PÚBLICO (#6691).
scripts/_tmp_*/
__pycache__/

{
  "mcpServers": {
    "clarice": {
      "type": "http",
      "url": "https://mcp.clarice.ai/mcp",
      "headersHelper": "node scripts/mcp/clarice-headers.mjs",
      "headers": {
        "X-Clarice-Api-Key": "${CLARICE_API_KEY}"
      }
    },
    "kit": {
      "type": "http",
      "url": "https://app.kit.com/mcp"
    },
    "google-ads": {
      "command": "node",
      "args": ["scripts/mcp/run-google-ads-mcp.mjs"]
    },
    "doppler": {
      "command": "node",
      "args": ["scripts/mcp/run-doppler-mcp.mjs"]
    }
  }
}

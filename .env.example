CLARICE_API_KEY=
GEMINI_API_KEY=

# Anthropic API — chave RESTRITA de Console (console.anthropic.com), pay-as-
# you-go, SEPARADA da assinatura do Claude Code (mesma identidade/login, mas
# sistema de billing diferente — ver skill claude-api § Authentication).
# Usada pelo monitor de citação GEO (scripts/geo-citation-monitor.ts, #4558
# Parte C, #4904) — o script consulta a Messages API (com web_search) pra
# checar se diar.ia.br aparece na resposta de um conjunto fixo de perguntas
# pt-BR. Chegou a ficar deliberadamente vazia por decisão do editor (evitar
# o setup de uma key nova), revertida no mesmo dia (11/ago/2026): key criada
# em console.anthropic.com, org com US$5 de crédito e teto de gasto mensal
# de US$10 configurado no próprio Console. Pegue a sua em
# console.anthropic.com → API keys → Create key (nomeie algo como
# "diaria-geo-citation-monitor"; "Never" de expiração, já que alimenta uma
# task semanal — ver docs/geo-citation-monitor-setup.md § "Captura de usage
# e teto de custo" pro achado de latência variável desta chamada e por que o
# timeout/max_uses do provider Anthropic são diferentes dos outros dois).
ANTHROPIC_API_KEY=

# OpenAI Images API (image gen — gpt-image-2 default)
# Só necessário se platform.config.json > image_generator = "openai".
# Chave em: https://platform.openai.com/api-keys
# TAMBÉM alimenta o monitor de citação GEO acima (GEMINI_API_KEY idem) —
# cada provider desse script é opcional/independente, pula sem key (fail-soft).
OPENAI_API_KEY=

# Facebook Graph API (Stage 5 — publish-facebook.ts)
# Token de página com scope pages_manage_posts + pages_read_engagement
# Expira em 60 dias; regenerar em: https://developers.facebook.com/tools/explorer/
# Page ID: encontrar em https://www.facebook.com/diar.ia.br → Sobre → ID da página
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_API_VERSION=v25.0

# Meta Conversions API — CompleteRegistration server-side (#5504)
# System user token com permissão no dataset (pixel) 1285191740325112,
# gerado no Events Manager (Data Sources → Diar.ia → Settings → Conversions
# API → system user). Usado por scripts/lib/shared/meta-capi.ts, wired em
# workers/poll/src/subscribe.ts, workers/cursos/src/subscribe.ts,
# workers/reativar/src/index.ts (secret do Worker, `wrangler secret put`
# — não lido daqui em produção) e scripts/meta-capi-batch-send.ts (lido
# daqui via process.env). Fail-soft: ausente = no-op silencioso, nunca
# bloqueia cadastro.
META_CAPI_ACCESS_TOKEN=

# Instagram Graph API (Stage 5 — publish-instagram.ts) (#49)
# Conta @diar.ia.br — Business/Creator account vinculada a um Facebook App.
# Escopos necessários: instagram_basic, instagram_content_publish, pages_read_engagement
# Token de longa duração (60 dias) — renovar antes de expirar.
# Gerar em: https://developers.facebook.com/tools/explorer/
# Business Account ID: GET /me/accounts → instagram_business_account.id
#   ou: https://developers.facebook.com/apps/ → seu app → Instagram → Business Account ID
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_API_VERSION=v25.0

# Threads API (Stage 5 — publish-threads.ts) (#2479, agendamento #3944 Parte B)
# Conta @diar.ia.br — app próprio no Meta for Developers (produto "Threads API",
# separado do app Instagram/Facebook), com a conta como Threads Tester aceito.
# Token de longa duração — gerar em developers.facebook.com/apps/<id> →
# Threads API → Configurações → "Gerador de token do usuário" (por testador).
# Threads User ID: GET https://graph.threads.net/v1.0/me?fields=id,username
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
THREADS_API_VERSION=v1.0

# Beehiiv REST API (fetch-beehiiv-poll-stats.ts, beehiiv-sync.ts, refresh-dedup.ts)
# Chave em: https://app.beehiiv.com/settings/workspace/api
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_b9534d43-9bc1-47cc-bddc-b98d8fa0ddf5

# Kit (ConvertKit) REST API — migração Beehiiv → Kit reativada em 24/08/2026
# (#461, gate em #6047). Plano contratado 24/08/2026. Chave em:
# https://app.kit.com/account_settings/developer_settings (Creator plan).
# Distinta do MCP (`.mcp.json` -> "kit", https://app.kit.com/mcp, provavelmente
# OAuth via /mcp) — esta var alimenta os scripts REST que ainda não existem
# (ver #463/#464/#466/#467); nenhum script lê esta var ainda.
KIT_API_KEY=

# Opcional (#5231, gate — OFF por padrão, NÃO setar ainda). Nome do custom
# field na Beehiiv onde promoteBeehiivSubscription (evaluate-brevo-diaria.ts)
# preserva a origem de aquisição original no DELETE+CREATE de promoção.
# Ausente = sem custom_fields novo (comportamento de hoje). Só definir DEPOIS
# de criar o custom field `origem_original` na Beehiiv (item 1 da #5231,
# ação manual via dashboard/MCP) — setar antes disso faz o CREATE falhar
# (campo inexistente na publicação). Valor recomendado: "origem_original"
# (ORIGEM_ORIGINAL_FIELD_NAME em scripts/lib/shared/beehiiv-origem-original.ts).
BEEHIIV_ORIGEM_ORIGINAL_FIELD=

# Google OAuth (para Drive sync + Gmail inbox drain)
# Setup único: npx tsx scripts/oauth-setup.ts
# Criar credenciais em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo API — digest mensal parceria Clarice (#653, #654)
# Chave em: app.brevo.com → Settings → SMTP & API → API Keys → Create API Key
# Permissões necessárias: email campaigns (create, send test) + contacts (read)
BREVO_CLARICE_API_KEY=

# Brevo API — conta PRÓPRIA do editor (#4266), canal alternativo pro
# segmento Pending da Beehiiv (assinantes que se inscreveram mas nunca
# confirmaram o double opt-in). Free tier — cap de 300 envios/dia
# (platform.config.json > brevo_diaria.daily_send_cap). DISTINTA de
# BREVO_CLARICE_API_KEY acima (aquela é a conta da parceria Clarice).
# Chave em: app.brevo.com → Settings → SMTP & API → API Keys → Create API Key
# Permissões necessárias: email campaigns (create, send) + contacts (read/write).
# platform.config.json > brevo_diaria.list_id/sender_email ainda ficam null
# até o editor criar a conta/lista — ver comentário nesse bloco do config.
BREVO_DIARIA_API_KEY=

# Brevo transacional — worker `poll`, e-mail de confirmação de merge
# cross-device do jogo "É IA?" web (#3996). NÃO lido por scripts Node — só
# usado como fonte pra `wrangler secret put` (ver workers/poll/SECRETS.md).
# Pode ser a MESMA key de BREVO_CLARICE_API_KEY acima, desde que ela tenha
# permissão de "transactional emails" habilitada na conta.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# HMAC key do token opaco de voto do "É IA?" (#4487/#4517) — MESMA key que o
# Worker `poll` usa (workers/poll/SECRETS.md, boot-critical pra /vote).
# Lida diretamente por scripts Node: scripts/inject-poll-token.ts (Beehiiv,
# custom field `poll_token`) e scripts/inject-poll-token-brevo.ts (Brevo,
# atributo de contato `POLL_TOKEN`, chamado inline por publish-daily-brevo.ts).
POLL_SECRET=

# Cloudflare Workers AI (image gen zero-cost — #88, #254)
# Só necessário se platform.config.json > image_generator = "cloudflare".
# Conta: https://dash.cloudflare.com (free)
# Token: https://dash.cloudflare.com/profile/api-tokens com scope "Workers AI"
# Account ID: visível em qualquer URL do dashboard dash.cloudflare.com/{account_id}/...
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare KV write — push de dados pros Workers diaria-dashboard / poll / leaderboard
# (build-diaria-dashboard-data.ts --push, clarice-engagement-cohorts.ts, cloudflare-kv-upload.ts).
# Token com scope "Workers KV Storage:Edit" (+ Account). Mesmo Account ID acima.
# Usado pelo wrapper de schedule scripts/run-diaria-dashboard-push.cmd (ver docs/dashboard-schedule.md).
CLOUDFLARE_WORKERS_TOKEN=
# Namespace ID do KV do diaria-dashboard. Opcional: o wrapper passa --kv-namespace-id
# explicitamente; setar aqui só se for remover o flag do .cmd (ver docs/dashboard-schedule.md).
DASHBOARD_KV_NAMESPACE_ID=

# Auth do dashboard clarice-dashboard (workers/brevo-dashboard) — MESMO token
# que o editor usa pra logar via cookie no navegador (workers/brevo-dashboard
# secret `AUTH_TOKEN`, `wrangler secret put AUTH_TOKEN`). Usado só por
# scripts/clarice-dashboard-precompute.ts (#5217) — task horária que grava o
# write-through do dashboard (dash:lastgood:campaigns) enviando
# `Authorization: Bearer <token>`, sem depender de o editor ter aberto a
# página no navegador naquela hora. Trade-off aceito: rotacionar este token
# desloga o login humano E quebra a task agendada ao mesmo tempo — os dois
# caminhos validam contra o MESMO valor, por decisão do editor (13/08/2026,
# nenhum secret novo).
CLARICE_DASHBOARD_AUTH_TOKEN=

# Bing Webmaster Tools API (#4909) — submit de sitemap (SubmitFeed) e, no
# futuro, leitura de dados de query pt-BR (destrava a #4908). Chave em:
# Bing Webmaster Tools → Settings → API access. Verificação de propriedade
# em si é feita por CNAME de DNS na zona Cloudflare, não por esta key.
BING_WEBMASTER_API_KEY=

# Buffer Access Token (#5766) — token pessoal gerado em
# https://publish.buffer.com/settings/api. Usado por scripts/verify-twitter-posts.ts
# pra confirmar entrega real dos posts do X/Twitter (que saem via Buffer, não API
# direta — ver docstring de scripts/prep-twitter-posts.ts). Consulta a API GraphQL
# em https://api.buffer.com/graphql — NÃO a REST legacy em api.bufferapp.com, que
# rejeita tokens pessoais com 401 "Public API tokens are not accepted". A
# publicação em si continua via MCP (mcp__claude_ai_Buffer__create_post, chamada
# só de dentro de sessão de agente) — este token é só pra LEITURA de status
# pós-dispatch, headless.
BUFFER_ACCESS_TOKEN=

# Make.com webhook para auto-publicação no LinkedIn (#506, #596)
# Cenário Make.com recebe POST com { text, image_url, scheduled_at, destaque, action, parent_destaque }.
# Scenario com Router: action="post" cria company post; action="comment" busca latest
# Diar.ia post + adiciona comment (#595).
# Setup: ver docs/make-linkedin-setup.md + docs/make-diaria-extend-comment.md (#595).
# **Tratar como secret** — qualquer um com a URL pode disparar publicações.
# Tem precedência sobre platform.config.json > publishing.social.linkedin.make_webhook_url
# (que deve ficar vazio em código versionado).
MAKE_LINKEDIN_WEBHOOK_URL=

# Make.com webhook API key (#3903) — header `x-make-apikey` enviado ao POSTar
# no webhook acima (scripts/publish-linkedin.ts::postToMakeWebhook e
# workers/linkedin-cron/src/dispatch.ts::fireLinkedIn). Reativa o
# `authenticationMethod` que o scenario Make ANTERIOR (2270381) já tinha —
# migração incremental: enquanto ausente, o POST sai sem o header (comportamento
# de hoje, com warning); setar aqui assim que o scenario novo tiver auth
# habilitada. Gerar/ver em Make.com → scenario → Webhooks → módulo → chave de API.
# Worker usa o secret equivalente: `wrangler secret put MAKE_WEBHOOK_API_KEY`
# (workers/linkedin-cron/) — mesmo valor, secret separado (Worker não lê .env).
MAKE_WEBHOOK_API_KEY=

# Make.com webhook para Pixel personal LinkedIn (#595)
# Scenario "Pixel LinkedIn" autenticado com vjpixel personal. Recebe payload
# { text, image_url, scheduled_at, destaque, action: "comment", parent_destaque }
# e adiciona comment ao último post Diar.ia. Único escopo: comment_pixel (T+8min).
# **NÃO é o mesmo URL do scenario Diar.ia** — auth e webhook URL separados.
# Setup: ver docs/make-pixel-linkedin-setup.md (#595).
# Esta variável é **opcional** localmente — Worker é quem realmente fira o webhook
# (Worker secret: `wrangler secret put MAKE_PIXEL_WEBHOOK_URL` em workers/linkedin-cron/).
# #3627 (260716): comment_pixel deixou de ser gerado pelo social-linkedin agent
# (decisão do editor) — este webhook nunca mais recebe payload real. Mantido
# (não removido) porque o Worker/scenario Make continuam existindo como infra;
# desligar a integração é um passo separado, fora do escopo de #3627.
MAKE_LINKEDIN_PIXEL_WEBHOOK_URL=

# Brave Search API (fetch-websearch-batch.ts — #1555 default desde 260529 #1560)
# Free tier: 2000 queries/mês (suficiente: ~16 queries/edição × 30 = 480/mês).
# Gerar em: https://brave.com/search/api/
# Default WEBSEARCH_BACKEND=brave — Path A 10× mais rápido + $0 vs agents Haiku.
# Fallback automático pra Path B (agents) quando BRAVE_API_KEY ausente.
# Rollback: setar WEBSEARCH_BACKEND=agents pra forçar Path B mesmo com API key presente.
BRAVE_API_KEY=
WEBSEARCH_BACKEND=brave

# MillionVerifier (verify-emails-mv.ts — #1297)
# Verifica listas de email (ex: T02 ex-assinantes) antes de mandar pro Brevo,
# pra não degradar a reputação do IP/domínio com bounce alto. Pay-as-you-go
# (~$1.90/1000) ou subscription (~$0.99/1000). Custo one-time.
# Pegar a key em: https://app.millionverifier.com → API
MILLION_VERIFIER_API_KEY=

# Notificações push (watchdog stall, halt banner, Studio gate/AskUserQuestion
# pendente) — canal e-mail via Gmail (#5341, decisão
# do editor 15/08/2026 de padronizar em e-mail em vez de instalar um app novo).
# Sem env var própria — reusa a MESMA credencial OAuth de GOOGLE_CLIENT_ID/
# GOOGLE_CLIENT_SECRET (ver seção Google OAuth mais abaixo) já usada por
# Drive sync/inbox-drain/imagens sociais. Setup: npx tsx scripts/oauth-setup.ts.
# Destinatário: platform.config.json -> inbox.editor_personal_email
# (default vjpixel@gmail.com). Ver scripts/lib/push-notify.ts.

# Studio UI — base URL pra deep-links nas notificações push (#3564)
# O Studio ainda roda só local (npm run studio -> http://127.0.0.1:4174,
# #3560 acesso remoto NÃO existe ainda) — um deep-link com esse default só
# abre a tela certa a partir da MESMA máquina/rede. NÃO setar pra um domínio
# público (studio.diar.ia.br) até o #3560 existir de fato.
# STUDIO_PUBLIC_BASE_URL=http://127.0.0.1:4174

# Stripe API — análise de cupons (stripe-coupon-usage.ts, #2717)
# Chave RESTRITA e READ-ONLY (permissões: Coupons=Read, Customers=Read,
# Invoices=Read, Subscriptions=Read, Charges=Read). Nunca escreve nada.
# Criar em: https://dashboard.stripe.com/apikeys → "Restricted key"
# O valor vai em .env (nunca commitado).
STRIPE_API_KEY=

# apoia.se API — verificação de apoiadores pagantes (scripts/lib/apoia-se.ts,
# scripts/apoia-se-probe.ts, #3500). Credenciais liberadas via suporte apoia.se
# (thread Gmail da solicitação #152647, suporte@apoia.se) — não há self-service
# público conhecido; contatar o suporte da apoia.se pra obter as suas.
# Doc oficial: https://apoiase.notion.site/APOIA-se-API-4b87651821884061a7532abfd7f26087
# Rate limit: 5.000 req/mês, 5 req/s (client throttla + cacheia por mês-competência).
APOIA_SE_API_KEY=
APOIA_SE_API_SECRET=
APOIA_SE_CAMPAIGN=diaria

# --- Google Ads API (#5262) -------------------------------------------------
# Leitura das métricas das nossas próprias campanhas (custo, cliques,
# conversões) pro relatório de custo por leitor (#5236). Somente leitura —
# nenhuma operação de escrita é implementada.
#
# ATENÇÃO à distinção que confunde: o developer token pertence à conta
# GERENCIADORA (MCC 623-609-4249), não à conta de anunciante que tem os dados
# (236-921-9639). A API quer os dois, sem hífens: LOGIN_CUSTOMER_ID é a MCC,
# CUSTOMER_ID é a conta consultada. O API Center só existe em conta de
# administrador — em conta de anunciante ele nem aparece no menu.
#
# Obter: API Center da MCC → "Ver token" (developer token); Google Auth
# Platform → Clientes → App para computador (client id/secret). O refresh
# token NÃO é copiado à mão — rodar:
#   doppler run -- npx tsx scripts/google-ads-associate-token.ts --auth
# que grava direto no Doppler sem imprimir o valor.
#
# Nível atual do token: "Conta de teste" — NÃO lê a conta real. Pedido de
# Basic Access na fila do Google. Ver docs/google-ads-api-setup.md.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=6236094249
GOOGLE_ADS_CUSTOMER_ID=2369219639

# Id do projeto Google Cloud dono do developer token acima (#5237) — exigido
# pelo MCP oficial `google-ads-mcp` declarado em `.mcp.json` (env do
# servidor). Console Cloud → seletor de projeto no topo → "ID do projeto"
# (não o "Nome do projeto"): velvety-tube-505505-d1.
#
# NÃO é usado por `scripts/google-ads-ingest-spend.ts` (corrigido 17/08/2026).
# O CLI chegou a exigi-lo junto com as demais GOOGLE_ADS_*, e como esta var
# nunca foi sincronizada no Doppler, a ingestão saía com o motivo enganoso
# "variável de ambiente ausente: GOOGLE_PROJECT_ID" ANTES de tentar a
# chamada — escondendo o estado real da API. O caminho REST autentica com
# CLIENT_ID/SECRET/REFRESH_TOKEN e nunca leu este valor.
GOOGLE_PROJECT_ID=

# Caminho pro JSON de credenciais de uma Service Account do GCP (ADC —
# Application Default Credentials), única forma de auth que o MCP `google-ads`
# de `.mcp.json` de fato lê (#5237, achado do fleet review do PR #5380: a
# 1ª versão deste entry declarava GOOGLE_ADS_CLIENT_ID/SECRET/REFRESH_TOKEN,
# que são do fluxo REST usado por scripts/lib/google-ads-ingest.ts, não do
# contrato do servidor MCP em si — READMEs distintos, vars distintas).
# **Ainda não existe** — requer criar a Service Account no GCP Console
# (IAM → Service Accounts → Create) e baixar a chave JSON, ação do editor
# fora do escopo do #5237/#5380. Sem isso, o MCP `google-ads` não autentica
# (o script de ingestão REST em scripts/google-ads-ingest-spend.ts não
# depende desta var — usa CLIENT_ID/SECRET/REFRESH_TOKEN acima, caminho
# separado e já fail-soft).
GOOGLE_APPLICATION_CREDENTIALS=

# GA4 Data API (#5248) — ingestão de comportamento pós-clique da propriedade
# `Diaria` (property ID 516813959, measurement ID G-SGXBD0R9CD), confirmada
# COLETANDO ao vivo em 16/08/2026 (ver issue #5248 — comentário final corrige
# o Property ID: 378028168 é na verdade o Account ID, #5625). Property ID
# NUMÉRICO (ex: 123456789), NÃO o Measurement ID (G-XXXXXXX) — ver Admin →
# Detalhes da propriedade na UI do GA4. `scripts/ga4-sync.ts`/`ga4-client.ts`
# só precisam desta var (reusam o MESMO OAuth de GOOGLE_CLIENT_ID/SECRET
# acima, scope analytics.readonly, adicionado a scripts/oauth-setup.ts —
# reaprovar no browser se o token já existia antes desta mudança);
# `scripts/ga4-ingest.ts` (implementação alternativa/standalone) usa as 3
# vars abaixo com o mesmo padrão OAuth refresh-token do bloco GOOGLE_ADS_*
# acima — escolha de consistência, não a única forma de auth que a Data API
# aceita (Service Account/ADC também funciona). Passo-a-passo completo (tag
# GTM, confirmar dado, ação de painel do editor): docs/ga4-data-api-setup.md
# e docs/ga4-api-setup.md. **NUNCA obrigatório** — ambos os caminhos
# degradam pro aviso + exit 0 sem quebrar nada se qualquer uma faltar.
GA4_PROPERTY_ID=516813959
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REFRESH_TOKEN=

# Microsoft Advertising Reporting API (#5502) — ingestão automática do
# canal "Microsoft Advertising" pra data/aquisicao/spend.csv, adaptador de
# scripts/lib/spend-ingest.ts (mesmo motor genérico do Google Ads acima).
# `scripts/microsoft-ads-ingest-spend.ts` é fail-soft: env var ausente faz
# o script degradar pro CSV manual (exit 0, spend.csv intocado) — nunca
# quebra `cac-report.ts`. As chaves de atribuição por referrer/UTM
# continuam DELIBERADAMENTE fora de `CHANNEL_KEY_SPECS` até haver campanha
# real pra observar (não confundir "gasto importado" com "assinantes
# atribuídos" — são passos independentes). Ver docs/microsoft-ads-api-setup.md.
#
# Sempre exigidas, independente do identity provider:
MICROSOFT_ADS_DEVELOPER_TOKEN=
MICROSOFT_ADS_CUSTOMER_ID=
MICROSOFT_ADS_ACCOUNT_ID=
# Caminho Google (#5928) — o que a conta em uso hoje EXIGE (criada via
# "Sign in with Google"). Reusa GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET (ver
# acima); só o refresh token abaixo é específico deste uso.
MICROSOFT_ADS_GOOGLE_REFRESH_TOKEN=
# Caminho Azure AD (default histórico #5502) — vale pra outra conta
# Microsoft Advertising que NÃO tenha sido criada via "Sign in with Google".
MICROSOFT_ADS_CLIENT_ID=
MICROSOFT_ADS_CLIENT_SECRET=
MICROSOFT_ADS_REFRESH_TOKEN=

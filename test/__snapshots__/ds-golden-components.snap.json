      "html": "<!-- É IA? (poll) -->\n<tr><td class=\"pad\" style=\"padding:48px 16px 0;\">\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr>\n    <td style=\"font-family:'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;font-size:12px;font-weight:bold;letter-spacing:2px;text-transform:uppercase;color:#171411;white-space:nowrap;padding-right:12px;\"><span style=\"color:#00A0A0;\">&#9679;</span>&nbsp;É IA?</td>\n    <td style=\"width:100%;border-bottom:1px solid #EBE5D0;font-size:0;line-height:0;\">&nbsp;</td>\n  </tr></table>\n  <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:28px;border-collapse:separate;border-spacing:0\"><tr>\n    <td style=\"background:#EBE5D0;border-radius:12px;padding:12px 12px;\">\n      <p style=\"margin:0;font-family:Georgia, 'Times New Roman', serif;font-size:26px;line-height:1.2;color:#171411;\">Clique na imagem que foi gerada por IA</p>\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin-top:22px;\">\n        <tr><td><a href=\"https://eia.diar.ia.br/vote?email={{email}}&edition=260999&choice=A\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"text-decoration:none;\"><img src=\"{{IMG:01-eia-A.jpg}}\" alt=\"Imagem A\" width=\"600\" style=\"display:block;width:100%;height:auto;border-radius:6px;\" border=\"0\"/></a></td></tr>\n        <tr><td style=\"padding-top:16px;\"><a href=\"https://eia.diar.ia.br/vote?email={{email}}&edition=260999&choice=B\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"text-decoration:none;\"><img src=\"{{IMG:01-eia-B.jpg}}\" alt=\"Imagem B\" width=\"600\" style=\"display:block;width:100%;height:auto;border-radius:6px;\" border=\"0\"/></a></td></tr>\n      </table>\n      <table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td>\n        <!-- #3103: crédito da imagem continua 12px (linha secundária, não faz\n             parte do loop de engajamento resultado→leaderboard). -->\n        <p style=\"margin:16px 0 0;font-family:'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;font-size:12px;line-height:1.5;color:#171411;\">Foto: Gerado com Gemini.</p>\n      </td></tr>\n      <tr><td><p style=\"margin:6px 0 0;font-family:'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;font-size:16px;line-height:1.5;color:#171411;\">Resultado da última edição: 73% acertaram</p></td></tr>\n      <tr><td align=\"left\" style=\"padding:8px 0 0 0;\">\n        <p style=\"margin:8px 0 0;font-family:'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;font-size:16px;line-height:1.5;color:#171411;\">🏆 <strong>Vencedores</strong>: 1º Davyd, 2º Luisao P</p>\n      </td></tr>\n      <tr><td align=\"left\" style=\"padding:8px 0 0 0;\">\n        <p style=\"margin:8px 0 0;font-family:'Geist', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;font-size:16px;line-height:1.5;color:#171411;\">Veja o ranking de quem mais acerta → <a href=\"https://eia.diar.ia.br/leaderboard\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:#00A0A0;text-decoration:underline;font-weight:bold;display:inline-block;padding:4px 0;\">ranking</a></p>\n      </td></tr>\n      </table>\n    </td>\n  </tr></table>\n</td></tr>"

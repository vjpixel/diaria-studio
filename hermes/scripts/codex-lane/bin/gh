#!/usr/bin/env bash
# gh shim do elo `codex exec` do contínuo (#10560). Fica na frente do PATH só
# no ambiente do processo `codex` (hermes/scripts/lib/codex-lane.sh) — nunca
# instalado globalmente. Substitui, fora do Claude Code, o que os hooks de
# `.claude/hooks/` fazem em volta de `gh pr create`/`gh pr merge`:
#
#   - `gh pr merge` e merge via `gh api` (REST `pulls/N/merge`, `merges`,
#     escrita em `git/refs/heads/master|main`; GraphQL `mergePullRequest`/
#     `enablePullRequestAutoMerge`/`mergeBranch`) → recusados (exit 3) — no
#     argv E no conteúdo de `--input <arq>`/`-F campo=@arq` (inclusive stdin,
#     #10585). O merge do contínuo é do `continuo-pr-review.sh`, nunca da
#     sessão que implementa (#6864; equivalente do
#     block-gh-pr-merge-subagent.mjs).
#   - Criação de PR por fora do `gh pr create` (#10585) → recusada: `gh api`
#     com método ≠ GET em `repos/O/R/pulls` (o gh usa POST sozinho quando há
#     -f/-F/--input) e a mutation GraphQL `createPullRequest`.
#   - `gh alias` (set/import/…) e invocação de alias já existente (#10585) →
#     recusados: o alias expande DENTRO do gh real, depois deste shim ler o
#     argv (`gh alias set m 'pr merge'` + `gh m 5`).
#   - `gh pr create` → só a partir de branch `continuo/*` (#6446/#8588); roda
#     antes o guard de PII/artefato de runtime
#     (.claude/hooks/block-pr-create-pii-runtime-artifacts.mjs, #6753/#6971)
#     com um payload sintético; depois de criada, registra a URL em
#     ${TMPDIR}/codex-lane-pr-created.log. O review (papel do
#     pr-create-review.mjs no Claude Code) é o `continuo-pr-review.sh`, que
#     revisa toda PR aberta e é o único merger.
#
# GARANTIA REAL (#10585) — este shim NÃO é fronteira de segurança. Ele barra
# o caminho óbvio (o modelo seguindo o hábito de `gh pr merge`), não um
# processo determinado a contornar: com o sandbox `danger-full-access` o
# codex alcança o gh real por caminho absoluto (`/usr/bin/gh`), por `curl`
# na API com o token do gh, ou editando ~/.config/gh. O que de fato impede
# merge fora do gate é o `continuo-pr-review.sh` ser o ÚNICO merger do
# contínuo (e, idealmente, proteção de branch no GitHub exigindo o review);
# PR aberta por fora do shim continua passando pelo mesmo review, só sem o
# guard de PII/branch daqui.
#
# Todo o resto passa direto pro próximo `gh` do PATH (inclusive o
# gh-wrapper.mjs do #8884, quando instalado), sem alterar argv.
set -uo pipefail

SELF="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "$SELF")"

find_real_gh() {
  local d cand
  local IFS=:
  for d in $PATH; do
    [ -n "$d" ] || continue
    cand="$d/gh"
    [ -x "$cand" ] || continue
    [ "$(readlink -f "$cand")" = "$SELF" ] && continue
    [ "$(readlink -f "$d")" = "$SELF_DIR" ] && continue
    echo "$cand"
    return 0
  done
  return 1
}

REAL_GH=$(find_real_gh) || { echo "[codex-lane gh] gh real não encontrado no PATH" >&2; exit 127; }

refuse() {
  echo "[codex-lane gh #10560] recusado: $1" >&2
  [ -n "${STDIN_BUF:-}" ] && rm -f "$STDIN_BUF"
  exit 3
}

# Subcomando = os 2 primeiros argumentos posicionais. Flags que levam valor
# na forma separada (`-R owner/repo`, `--repo owner/repo`, `--hostname h`)
# têm o VALOR pulado — senão `gh pr -R owner/repo merge 5` lia
# `sub=owner/repo` e o merge passava direto pro gh real (review da PR #10583,
# P2). Flag desconhecida com valor separado ainda poderia deslocar a leitura;
# por isso, além disso, `merge` em QUALQUER posição depois de `pr` também é
# recusado (lado seguro: falso positivo só recusa).
pos=()
skip_next=0
for a in "$@"; do
  if [ "$skip_next" -eq 1 ]; then
    skip_next=0
    continue
  fi
  case "$a" in
    -R|--repo|--hostname) skip_next=1 ;;
    -*) ;;
    *) pos+=("$a") ;;
  esac
  [ "${#pos[@]}" -ge 2 ] && break
done
group="${pos[0]:-}"
sub="${pos[1]:-}"

if [ "$group" = "pr" ]; then
  [ "$sub" = "merge" ] && refuse "gh pr merge — a sessão do contínuo nunca mergeia; o merge é do continuo-pr-review.sh (#6864)"
  seen_pr=0
  for a in "$@"; do
    if [ "$seen_pr" -eq 1 ] && [ "$a" = "merge" ]; then
      refuse "gh pr ... merge (argv: $*) — a sessão do contínuo nunca mergeia; o merge é do continuo-pr-review.sh (#6864)"
    fi
    [ "$a" = "pr" ] && seen_pr=1
  done
fi
# #10585: alias expande dentro do gh real, depois deste shim ler o argv.
# `gh alias` inteiro é recusado; e um 1º posicional que não é comando
# embutido só é repassado se NÃO for alias já gravado na config do gh.
if [ "$group" = "alias" ]; then
  refuse "gh alias — alias expande dentro do gh real, fora do alcance deste shim (#10585)"
fi
case "$group" in
  ''|agent-task|api|attestation|auth|browse|cache|codespace|completion|config|copilot|extension|gist|gpg-key|help|issue|label|org|pr|preview|project|release|repo|ruleset|run|search|secret|ssh-key|status|variable|workflow) ;;
  *)
    # #10588 item b: comparação LITERAL do nome (awk + ENVIRON, sem regex nem
    # escape de `-v`). O escape por sed cobria só parte dos metacaracteres
    # ERE — alias `m+` virava a regex `m+:`, que não casa a linha `m+: ...`
    # (fail-open).
    if "$REAL_GH" alias list 2>/dev/null | CODEX_LANE_GH_GROUP="$group" awk '
        { s = $0; sub(/^[ \t]+/, "", s); i = index(s, ":")
          if (i > 1 && substr(s, 1, i - 1) == ENVIRON["CODEX_LANE_GH_GROUP"]) found = 1 }
        END { exit !found }'; then
      refuse "alias do gh '$group' — alias expande dentro do gh real, fora do alcance deste shim (#10585)"
    fi
    ;;
esac

# Merge (REST pulls/N/merge e merges, GraphQL mergePullRequest/enablePullRequestAutoMerge/mergeBranch).
MERGE_RE='pulls/[0-9]+/merge|(^|[^a-z_])repos/[^/[:space:]]+/[^/[:space:]]+/merges([^a-z_]|$)|mergePullRequest|enablePullRequestAutoMerge|mergeBranch'
# Criação de PR por GraphQL.
CREATE_PR_RE='createPullRequest'
STDIN_BUF=""

if [ "$group" = "api" ]; then
  # Parse do `gh api`: endpoint (1º posicional depois de `api`), método, e as
  # fontes de corpo — `--input <arq>` e `-F campo=@arq` (o gh LÊ o arquivo;
  # `@-` e `--input -` = stdin). Valores de flag em forma separada,
  # `--flag=valor` e `-Xvalor` (pflag aceita os três).
  endpoint=""
  method=""
  has_body=0
  body_files=()
  seen_api=0
  prev=""
  for a in "$@"; do
    if [ "$seen_api" -eq 0 ]; then
      [ "$a" = "api" ] && seen_api=1
      prev=""
      continue
    fi
    val=""
    flag=""
    case "$prev" in
      -X|--method) method="$a"; prev=""; continue ;;
      -f|--raw-field|-F|--field) flag="$prev"; val="$a" ;;
      --input) has_body=1; body_files+=("$a"); prev=""; continue ;;
      -H|--header|-q|--jq|-t|--template|--hostname|--cache|-p|--preview|-R|--repo) prev=""; continue ;;
    esac
    if [ -z "$flag" ]; then
      case "$a" in
        --method=*) method="${a#--method=}"; prev=""; continue ;;
        -X?*) method="${a#-X}"; prev=""; continue ;;
        --input=*) has_body=1; body_files+=("${a#--input=}"); prev=""; continue ;;
        --raw-field=*|--field=*) flag="${a%%=*}"; val="${a#*=}" ;;
        -f?*|-F?*) flag="${a:0:2}"; val="${a:2}" ;;
        -*) prev="$a"; continue ;;
        *) [ -z "$endpoint" ] && endpoint="$a"; prev=""; continue ;;
      esac
    fi
    has_body=1
    prev=""
    # Só -F/--field lê `@arq` (-f/--raw-field manda o texto literal, já
    # coberto pela varredura do argv abaixo).
    case "$flag" in
      -F|--field)
        case "$val" in
          *=@*) body_files+=("${val#*=@}") ;;
        esac
        ;;
    esac
  done

  # Corpo vindo do stdin: bufferizado num arquivo (checado como os demais) e
  # devolvido como stdin do gh real no exec final.
  for f in "${body_files[@]+"${body_files[@]}"}"; do
    if [ "$f" = "-" ] && [ -z "$STDIN_BUF" ]; then
      STDIN_BUF=$(mktemp "${TMPDIR:-/tmp}/codex-lane-gh-stdin.XXXXXX") || refuse "gh api com corpo no stdin e mktemp falhou — sem como checar o conteúdo (#10585)"
      cat > "$STDIN_BUF"
    fi
  done

  for a in "$@"; do
    printf '%s' "$a" | command grep -qE "$MERGE_RE" && \
      refuse "merge via gh api ('$a') — a sessão do contínuo nunca mergeia (#6864)"
    printf '%s' "$a" | command grep -qE "$CREATE_PR_RE" && \
      refuse "criação de PR via gh api GraphQL ('$a') — só gh pr create, a partir de continuo/* (#10585)"
  done
  for f in "${body_files[@]+"${body_files[@]}"}"; do
    src="$f"
    [ "$f" = "-" ] && src="$STDIN_BUF"
    if [ ! -r "$src" ]; then
      # Arquivo que o shim não lê, o gh real também não lê com sucesso —
      # mas recusar é o lado seguro de "não sei o que vai ser enviado".
      refuse "gh api com corpo em '$f' ilegível pelo shim — não dá pra checar merge/criação de PR (#10585)"
    fi
    command grep -qE "$MERGE_RE" "$src" && \
      refuse "merge via gh api (corpo em '$f') — a sessão do contínuo nunca mergeia (#6864)"
    command grep -qE "$CREATE_PR_RE" "$src" && \
      refuse "criação de PR via gh api GraphQL (corpo em '$f') — só gh pr create, a partir de continuo/* (#10585)"
  done

  # REST: método efetivo (o gh troca GET por POST sozinho quando há corpo).
  eff_method=$(printf '%s' "${method:-}" | tr '[:lower:]' '[:upper:]')
  if [ -z "$eff_method" ]; then
    if [ "$has_body" -eq 1 ]; then eff_method="POST"; else eff_method="GET"; fi
  fi
  if [ "$eff_method" != "GET" ] && [ "$eff_method" != "HEAD" ] && \
     printf '%s' "$endpoint" | command grep -qE '(^|/)repos/[^/]+/[^/]+/pulls/?(\?.*)?$'; then
    refuse "gh api $eff_method $endpoint — criação de PR só por gh pr create, a partir de continuo/* (#10585)"
  fi
  # Escrita direta no ref de master/main (equivale a merge sem PR).
  if [ "$eff_method" != "GET" ] && [ "$eff_method" != "HEAD" ] && \
     printf '%s' "$endpoint" | command grep -qE 'git/refs/heads/(master|main)/?(\?.*)?$'; then
    refuse "gh api $eff_method $endpoint — escrita em master/main é do continuo-pr-review.sh, nunca da sessão (#6864)"
  fi
fi

if [ "$group" = "pr" ] && [ "$sub" = "create" ]; then
  head_branch=""
  prev=""
  for a in "$@"; do
    case "$prev" in
      -H|--head) head_branch="$a" ;;
    esac
    case "$a" in
      --head=*) head_branch="${a#--head=}" ;;
    esac
    prev="$a"
  done
  if [ -z "$head_branch" ]; then
    head_branch=$(git symbolic-ref --short -q HEAD 2>/dev/null || true)
  fi
  head_branch="${head_branch#*:}"
  case "$head_branch" in
    continuo/*) ;;
    *) refuse "gh pr create a partir de '${head_branch:-HEAD destacado}' — só branch continuo/fix-<issue>-<slug> (#6446/#8588)" ;;
  esac

  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
  pii_hook=""
  [ -n "$repo_root" ] && pii_hook="$repo_root/.claude/hooks/block-pr-create-pii-runtime-artifacts.mjs"
  if [ -n "$pii_hook" ] && [ -f "$pii_hook" ] && command -v node >/dev/null 2>&1; then
    payload=$(node -e 'process.stdout.write(JSON.stringify({tool_name:"Bash",tool_input:{command:"gh pr create"},cwd:process.argv[1]}))' "$repo_root")
    # Fail-open, em paridade com o hook original — mas com rastro em stderr
    # (review da PR #10583, P3): node quebrado, hook lançando ou JSON
    # malformado deixava o `gh pr create` seguir sem aviso nenhum.
    pii_err="${TMPDIR:-/tmp}/codex-lane-pii-guard.$$.err"
    verdict=$(printf '%s' "$payload" | node "$pii_hook" 2>"$pii_err")
    pii_rc=$?
    if [ "$pii_rc" -ne 0 ]; then
      echo "[codex-lane gh #10560] AVISO: guard de PII/artefato de runtime falhou (rc=$pii_rc) — seguindo SEM o guard (fail-open, paridade com o hook): $(head -c 400 "$pii_err" 2>/dev/null | tr '\n' ' ')" >&2
    elif [ -n "$verdict" ] && ! printf '%s' "$verdict" | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{try{JSON.parse(s)}catch{process.exit(1)}})' 2>/dev/null; then
      echo "[codex-lane gh #10560] AVISO: guard de PII/artefato de runtime devolveu JSON malformado — seguindo SEM o guard (fail-open): $(printf '%s' "$verdict" | head -c 400 | tr '\n' ' ')" >&2
    fi
    rm -f "$pii_err" 2>/dev/null || true
    if printf '%s' "$verdict" | command grep -q '"permissionDecision":"deny"'; then
      reason=$(printf '%s' "$verdict" | node -e 'let s="";process.stdin.on("data",c=>s+=c).on("end",()=>{try{process.stdout.write(JSON.parse(s).hookSpecificOutput.permissionDecisionReason)}catch{process.stdout.write(s)}})')
      refuse "guard de PII/artefato de runtime: $reason"
    fi
  fi

  out=$("$REAL_GH" "$@")
  rc=$?
  printf '%s\n' "$out"
  if [ "$rc" -eq 0 ]; then
    url=$(printf '%s\n' "$out" | command grep -oE 'https://github\.com/[^ ]+/pull/[0-9]+' | tail -n1)
    printf '%s %s %s\n' "$(date -u -Iseconds)" "${url:-?}" "$head_branch" >> "${TMPDIR:-/tmp}/codex-lane-pr-created.log" 2>/dev/null || true
    echo "[codex-lane gh] PR criada (${url:-url não lida}); o review é do continuo-pr-review.sh — não espere CI nem review aqui." >&2
  fi
  exit "$rc"
fi

if [ -n "$STDIN_BUF" ]; then
  # Devolve o stdin já consumido pela checagem (abre o fd e apaga o arquivo
  # antes do exec — nada fica pra trás em TMPDIR).
  exec 0<"$STDIN_BUF"
  rm -f "$STDIN_BUF"
fi
exec "$REAL_GH" "$@"
